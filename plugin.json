{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "skill-zh",
  "version": "1.1.0",
  "description": "在 Codex 桌面端浏览、搜索本机的中文技能目录。",
  "author": {
    "name": "xzzyy2000418-zyy"
  },
  "repository": "https://github.com/xzzyy2000418-zyy/skill-zh",
  "license": "MIT",
  "extensions": {
    "com.openai": {
      "requires_local_executor": true,
      "interface": {
        "displayName": "技能汉化管家",
        "shortDescription": "浏览本机中文技能目录",
        "longDescription": "打开中文技能目录，按名称、关键词或类别查找本机技能。目录读取已有汉化记录，浏览时不会改写技能文件。",
        "developerName": "xzzyy2000418-zyy",
        "category": "Productivity",
        "capabilities": [
          "Read"
        ],
        "defaultPrompt": [
          "打开技能汉化管家的中文技能目录预览"
        ]
      }
    }
  }
}
